<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="payment-service#2" author="tataji.g">
        <comment>Create INBOX_EVENT table for idempotent event consumption</comment>

        <createTable tableName="INBOX_EVENT">

            <column name="ID" type="uuid">
                <constraints nullable="false"
                             primaryKey="true"
                             primaryKeyName="PK_INBOX_EVENT"/>
            </column>

            <column name="EVENT_ID" type="uuid">
                <constraints nullable="false"/>
            </column>

            <column name="EVENT_TYPE" type="varchar(100)">
                <constraints nullable="false"/>
            </column>

            <column name="AGGREGATE_TYPE" type="varchar(50)">
                <constraints nullable="false"/>
            </column>

            <column name="AGGREGATE_ID" type="uuid">
                <constraints nullable="false"/>
            </column>

            <column name="PROCESSED_AT" type="timestamp">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="INBOX_EVENT"
                columnNames="EVENT_ID"
                constraintName="UK_INBOX_EVENT_EVENT_ID"/>

    </changeSet>

</databaseChangeLog>